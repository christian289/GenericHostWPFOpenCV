# Build from the app directory after the native image has passed its independent smoke tests.
ARG NATIVE_IMAGE=localhost/ohmyrudolph-native-build:local
FROM ${NATIVE_IMAGE} AS native
FROM mcr.microsoft.com/dotnet/sdk:10.0.403 AS managed
ARG APP_VERSION=1.0.0
WORKDIR /src
COPY Directory.Build.props Directory.Packages.props global.json ./
COPY OhMyRudolph.Abstractions/ OhMyRudolph.Abstractions/
COPY OhMyRudolph.Interop/ OhMyRudolph.Interop/
COPY OhMyRudolph.ProcessingHost/ OhMyRudolph.ProcessingHost/
RUN dotnet publish OhMyRudolph.ProcessingHost/OhMyRudolph.ProcessingHost.csproj \
    -c Release -r linux-x64 --self-contained true -o /out -p:Version=${APP_VERSION}

FROM ubuntu:24.04 AS runtime
ARG APP_VERSION=1.0.0
LABEL org.opencontainers.image.title="OhMyRudolph Processing Host" \
      org.opencontainers.image.version="${APP_VERSION}"
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libicu74 libssl3t64 libkrb5-3 zlib1g libjpeg8 \
    libopencv-core406t64 libopencv-calib3d406t64 libopencv-features2d406t64 \
    libopencv-highgui406t64 libopencv-imgcodecs406t64 libopencv-imgproc406t64 \
    libopencv-video406t64 libopencv-videoio406t64 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=managed /out/ /app/
COPY --from=native /app/libohmyrudolph_native.so /app/
COPY --from=native /app/mediapipe/ /app/mediapipe/
COPY --from=native /app/licenses/ /app/licenses/
RUN ldd /app/libohmyrudolph_native.so > /tmp/native-ldd \
    && ! grep -q 'not found' /tmp/native-ldd \
    && rm /tmp/native-ldd \
    && chmod -R a+rX /app
ENV OHMYRUDOLPH_RESOURCE_ROOT=/app ASPNETCORE_URLS=http://0.0.0.0:8080 \
    OHMYRUDOLPH_LEASE_SECONDS=30 DOTNET_EnableDiagnostics=0
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/app/OhMyRudolph.ProcessingHost"]
